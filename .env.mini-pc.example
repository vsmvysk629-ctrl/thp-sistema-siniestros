# Copia este archivo como .env (en la misma carpeta) y llena cada valor.
# No compartas este archivo con nadie.

# Contraseñas de la base de datos: inventa dos distintas, largas (20+ letras y números).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 32 o más caracteres al azar.
APP_SECRET=

# Primer administrador. La contraseña es temporal: el sistema pide cambiarla al entrar.
ADMIN_USERNAME=roy
ADMIN_PASSWORD=
ADMIN_NAME=Roy

# Déjalo en false mientras se entre por http://IP-de-la-mini-PC:3000.
# Ponlo en true solo si todos entran por https.
COOKIE_SECURE=false
